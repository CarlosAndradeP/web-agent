# API Base URL — used exactly as configured; adapt it for the environment:
#   Local development:       http://localhost:11431/v1
#   Docker → host services:  http://host.docker.internal:11431/v1
#   Docker → other container: http://nims-api:11431/v1  (same agent-net network)
API_BASE_URL=http://localhost:11431/v1

# API Key for the LLM provider — REQUIRED for AI features to work
API_KEY=

# Server port (default: 89)
PORT=89

# Workspace directory for user projects
WORKSPACE_DIR=./workspace

# Maximum agent steps per task (default: 100)
MAX_STEPS=100

# Default model ID for the agent
DEFAULT_MODEL=z-ai/glm-5.2

# Agent type: main | sub | none
AGENT_TYPE=none

# Data directory for SQLite database
DATA_DIR=./data

# Internal directory for project publication links used by Apache/PHP proxy
PROJECT_LINK_BASE_DIR=./data/project-links

# Docker container flag — set to 1 ONLY when running inside the container.
# It does not change API_BASE_URL.
# Auto-detected via /.dockerenv inside the container.
DOCKER_CONTAINER=0

# !!! SECURITY — These MUST be set before running in production !!!
# If not set, the app will refuse to start with NODE_ENV=production
# In development, insecure defaults are used with a warning
# JWT secrets — separate secrets for access and refresh tokens. If left
# empty, both fall back to JWT_SECRET (legacy) for backward compatibility.
# Rotating these secrets invalidates all existing tokens (forces logout).
JWT_SECRET=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ADMIN_PASSWORD=

# Initial credits for new users (default: 100)
INITIAL_CREDITS=100

# Public base URL for project links (optional)
PUBLIC_BASE_URL=

# Comma-separated browser origins allowed to call the API. Empty uses same-origin plus localhost in development.
CORS_ORIGINS=

# Number/list of trusted reverse proxies for Express. Leave empty unless behind a trusted proxy.
TRUST_PROXY=

# Mercado Pago Pix credit purchases
# Use a TEST- token/key for sandbox and production credentials only in production.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# BRL price for each credit purchased by Pix
PIX_CREDIT_PRICE_BRL=1

# Credits granted automatically to each registered user every 24 hours
DAILY_BONUS_CREDITS=2

# Dedicated Word workspace / ONLYOFFICE Docs Community
# Generate a long random value and use the exact same secret in both services.
ONLYOFFICE_JWT_SECRET=
# Browser-visible URL for the ONLYOFFICE service. Change this to your public
# HTTPS hostname when the app is accessed from another machine.
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
# Docker-internal addresses normally do not need to be changed.
ONLYOFFICE_INTERNAL_URL=http://onlyoffice-documentserver
ONLYOFFICE_STORAGE_URL=http://web-agent:89
