# API Base URL — adapte conforme o ambiente:
#   Local development:       http://192.168.3.5:11431/v1
#   Docker → host services:  http://host.docker.internal:11431/v1
#   Docker → other container: http://nims-api:11431/v1  (mesma rede agent-net)
API_BASE_URL=http://192.168.3.5:11431/v1
API_KEY=
PORT=89
WORKSPACE_DIR=./workspace
MAX_STEPS=100
DEFAULT_MODEL=z-ai/glm-5.1
AGENT_TYPE=none
DATA_DIR=./data
DOCKER_CONTAINER=1
